  "guidance": [
    {
      "id": "opencode-go-send-session-header",
      "text": "Go routes and caches by session: identify the client with its own user agent and send a stable x-opencode-session per conversation, unless the client sends a native session header Go recognises.",
      "applies": [
        "*"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Where can I use it?",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-validated-clients",
      "text": "Go names Hermes, Claude Code, Codex, ZCode, Pi, jcode, and Kilo Code CLI as working clients. Hermes, jcode, and Kilo Code CLI need a build with the session-header fix.",
      "applies": [
        "*"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Validated Clients",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-problematic-clients",
      "text": "Go reports incomplete session support for DeepSeek Harness, GitHub Copilot Chat, Kimi Code, and MiMo Code, so cache reuse and routing through them may be weaker.",
      "applies": [
        "*"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Known Problematic Clients",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-limits-windows",
      "text": "Go caps each model by dollar spend: 20% of its monthly limit per 5 hours and 50% per week. Costlier models such as Kimi K3, Grok 4.7, and Qwen3.8 Max run out fastest; batch work accordingly.",
      "applies": [
        "*"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Usage limits",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-kimi-k3-budget",
      "text": "Kimi K3 has one of the smallest monthly allowances on Go, about 490 requests a month at typical usage on the base plan. Save it for work that needs it.",
      "applies": [
        "kimi-k3"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Estimated requests, Kimi K3 row",
      "surfaces": [
        "card"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-grok-zdr-batch",
      "text": "On Go, zero data retention for Grok 4.7 and 4.6 disables the stateful Responses API, Files and Collections, and the Batch API. Do not plan on those through this route.",
      "applies": [
        "grok-4.7",
        "grok-4.6"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Privacy, Grok 4.7/4.6 note",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-muse-trains-on-prompts",
      "text": "The Muse Spark contributor route on Go is discounted because Meta may train on your prompts and completions, and it is limited to permitted regions. Send no private code through it.",
      "applies": [
        "muse-spark-1.3-contributor"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Privacy, Muse Spark 1.3 Contributor note",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-gpt-6-luna-price-step",
      "text": "GPT 6 Luna prices step up for requests above 272K tokens (input $0.10 to $0.20, output $0.50 to $0.75 per 1M), so keep prompts under that size.",
      "applies": [
        "gpt-6-luna"
      ],
      "class": "host",
      "source": "opencode-go-docs",
      "locator": "Usage limits, GPT 6 Luna rows",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "opencode-go-grok-4-7-price-step",
      "text": "Grok 4.7 and 4.6 cost double per token once a request passes 200K tokens on Go, so keep prompts under that size.",
      "applies": [
