      "class": "vendor",
      "source": "openai-deprecations",
      "locator": "2026-06-03 Reusable prompts table",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-10-07"
    },
    {
      "id": "gpt-6-astra-writing-style",
      "text": "Astra leans toward lists, tables, and Markdown, and repeats stock phrases across sessions. State the prose and format your product needs, and ban the specific filler phrases you see, rather than relying on defaults.",
      "applies": [
        "gpt-6-astra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Prompting best practices, Personality and writing style",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-10-07"
    },
    {
      "id": "gpt-6-astra-testing",
      "text": "Astra tests thoroughly, which can be more than a small change needs. Say which checks fit the change, and to broaden or repeat them only when something new or failing justifies it.",
      "applies": [
        "gpt-6-astra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Prompting best practices, Testing and verification",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-10-07"
    },
    {
      "id": "gpt-6-2-roles",
      "text": "Choose 6.2 Astra for the hardest reasoning and coding, or 6.2 Sol for everyday agents at lower cost. Move examples to the new IDs; keep the operator's Codex-configured default.",
