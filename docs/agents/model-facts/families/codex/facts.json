  "guidance": [
    {
      "id": "gpt-5-6-outcome-first",
      "text": "Describe the outcome, constraints, evidence, and completion bar, then let the model pick the path. Reserve ALWAYS and NEVER for true invariants.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Outcome-first prompts and stopping conditions",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-lean-prompts",
      "text": "Trim repeated rules, redundant examples, and unrelated tools. Cut one group at a time and rerun the evals; leaner prompts scored and cost better in OpenAI's sample.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Simplify prompts first",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-autonomy-boundaries",
      "text": "State once what a request authorizes: inspect and report for questions, edit and validate locally for changes, confirm before external writes, destructive steps, or scope growth.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Define autonomy and approval boundaries",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-effort-baseline",
      "text": "Start from the prior effort, test it and one level lower, and use medium as the default. Use high or xhigh only when evals gain; keep max for the hardest work.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Reasoning effort",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-brevity",
      "text": "GPT-5.6 answers more briefly than GPT-5.5 by default. Recheck broad 'be concise' rules, and set text.verbosity and required content instead.",
      "applies": [
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Personality, collaboration, and response length",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-verify-work",
      "text": "Give the model tools to validate its output and say which checks matter, such as targeted tests, type checks, builds, or a rendered screenshot.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Check work before finishing",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-prompt-first-effort",
      "text": "Before raising reasoning effort, look for a missing success criterion, dependency rule, tool-routing rule, or verification loop in the prompt.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-prompting",
      "locator": "Reasoning effort",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-5-6-pro-mode",
      "text": "Pro mode is set with reasoning.mode pro on the same model slug, independent of effort. Use it when quality outweighs latency and tokens; do not ask for it in the prompt.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "openai-gpt-5-6-guide",
      "locator": "Pro mode",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-6-astra-follow-through",
      "text": "GPT-6 Astra asks a focused question when the answer could change the outcome. Say what a request authorizes and to proceed on reasonable assumptions, or it may stop where you expect it to continue.",
      "applies": [
        "gpt-6-astra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Prompting best practices, Initiative and follow-through",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-6-astra-instruction-files",
      "text": "GPT-6 Astra weighs skills and AGENTS.md closely, and conflicting text can make it pause. Audit those files and state that the user's instructions outrank a skill's.",
      "applies": [
        "gpt-6-astra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Prompting best practices, Instruction following",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-6-astra-delegation",
      "text": "GPT-6 Astra may delegate to subagents less often than a workflow wants. Say when and how much to split work for parallel subagents.",
      "applies": [
        "gpt-6-astra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Prompting best practices, Subagent delegation",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gpt-6-no-sampling-params",
      "text": "Above none, omit temperature, top_p and log-probability options. Use Responses for tools; only the earlier GPT-6 Sol and Luna accept Chat Completions tools at none.",
      "applies": [
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-sol",
        "gpt-6-luna",
        "gpt-6.1-terra"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "Migration quickstart, Update API and model parameters, Reasoning effort, Tool calling, Unsupported parameters bullets",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-sol-61-choice",
      "text": "GPT-6.1 Sol is an earlier lower-cost reasoning option. It has no none or minimal effort (use low in their place), and tool calls need the Responses API.",
      "applies": [
        "gpt-6.1-sol"
      ],
      "class": "vendor",
      "source": "openai-gpt-6-astra-guide",
      "locator": "GPT-6.1 Sol section; Migration quickstart, Reasoning effort bullet",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-configuration-update",
      "text": "Append configuration_update to change effort or text.format without rewriting the prefix. Replay updates in order; context_management carries them through automatic compaction. Automatic truncation rejects them.",
      "applies": [
        "gpt-6.2-astra",
        "gpt-6.2-sol",
        "gpt-6.1-terra",
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-sol",
        "gpt-6-luna"
      ],
      "class": "vendor",
      "source": "openai-reasoning",
      "locator": "Change reasoning mid-conversation, preserve updates and compaction compatibility",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-async-tools",
      "text": "Set async: true on a function or custom tool and the model keeps working while your app runs it; return the result on the original call_id. Your app runs and tracks the jobs; hosted tools are excluded. Astra and later.",
      "applies": [
        "gpt-6.2-astra",
        "gpt-6.2-sol",
        "gpt-6.1-terra",
        "gpt-6-astra",
        "gpt-6.1-sol"
      ],
      "class": "vendor",
      "source": "openai-async-tool-calling",
      "locator": "How async tools work; Compatibility",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-mid-turn-steering",
      "text": "A user can add instructions to a running response over the Responses WebSocket with response.steer. The input is queued, then continues in a new response; sent output and started tools are not undone.",
      "applies": [
        "gpt-6.2-astra",
        "gpt-6.2-sol",
        "gpt-6.1-terra",
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-sol",
        "gpt-6-luna"
      ],
      "class": "vendor",
      "source": "openai-steering",
      "locator": "Send a steering message",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-cache-ttl",
      "text": "Use prompt_cache_options.ttl: 30m writes cost 1.25x input; Responses also offers 12h at 2.5x. Reads cost 0.05x on 6.2 Astra/Sol and 6.1 Sol/Terra, otherwise 0.1x for these models.",
      "applies": [
        "gpt-6.2-astra",
        "gpt-6.2-sol",
        "gpt-6.1-terra",
        "gpt-6-astra",
        "gpt-6.1-sol",
        "gpt-6-sol",
        "gpt-6-luna"
      ],
      "class": "vendor",
      "source": "openai-prompt-caching",
      "locator": "Cache lifetime; Summary of model differences",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-prompt-objects-shutdown",
      "text": "Reusable prompt objects are deprecated and v1/prompts shuts down on 2026-11-30. Keep prompts in application code and pass instructions and input straight to Responses.",
      "applies": [
        "*"
