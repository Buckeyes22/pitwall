      "reviewedAt": "2026-11-17"
    },
    {
      "id": "gpt-6-2-writing",
      "text": "6.2 Astra is briefer by default: reassess blanket brevity rules. Require final answers to explain the result on their own, without shorthand from tools, reasoning, or progress updates.",
      "applies": [
        "gpt-6.2-astra"
