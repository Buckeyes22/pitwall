  "guidance": [
    {
      "id": "kimi-k3-return-assistant-message",
      "text": "With Kimi K3, send each assistant message back whole, reasoning_content and tool_calls included. Keeping only the text breaks multi-turn chats and tool loops.",
      "applies": [
        "kimi-k3"
      ],
      "class": "vendor",
      "source": "kimi-thinking-models",
      "locator": "Frequently Asked Questions, Q1",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k3-omit-sampling",
      "text": "Kimi K3 fixes temperature, top_p, n and both penalties; leave them out of requests instead of setting them.",
      "applies": [
        "kimi-k3"
      ],
      "class": "vendor",
      "source": "kimi-k3",
      "locator": "Important limits",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k3-low-effort-for-latency",
      "text": "Kimi K3 cannot stop thinking. When its reasoning runs too long, lower reasoning_effort to low rather than looking for an off switch.",
      "applies": [
        "kimi-k3"
      ],
      "class": "vendor",
      "source": "kimi-k3",
      "locator": "FAQ, How do I turn off Kimi K3's chain-of-thought?",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k3-tool-retrieval-first",
      "text": "With a large tool inventory, declare one search tool, force it on the first turn with tool_choice required, then inject matching tool definitions on demand.",
      "applies": [
        "kimi-k3"
      ],
      "class": "vendor",
      "source": "kimi-k3-tool-calling",
      "locator": "Use tool_choice to force first-turn retrieval",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k2-thinking-max-tokens",
      "text": "Give Kimi thinking models max_tokens of at least 16000 and stream the reply, so reasoning plus answer is not truncated or timed out.",
      "applies": [
        "kimi-k2.7-code",
        "kimi-k2.6"
      ],
      "class": "vendor",
      "source": "kimi-thinking-models",
      "locator": "Configure multi-step tool calls",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k2.7-code-always-thinks",
      "text": "Kimi K2.7 Code always thinks and always keeps earlier reasoning: omit the thinking field, since passing disabled returns an error.",
      "applies": [
        "kimi-k2.7-code"
      ],
      "class": "vendor",
      "source": "kimi-thinking-models",
      "locator": "Choose the right thinking model, thinking.type row",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "kimi-k2.6-thinking-switch",
      "text": "Kimi K2.6 thinks by default. Turn it off with thinking.type disabled, or set thinking.keep to all to carry earlier reasoning across turns.",
      "applies": [
        "kimi-k2.6"
      ],
      "class": "vendor",
