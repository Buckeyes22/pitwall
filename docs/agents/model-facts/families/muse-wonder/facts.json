    {
      "id": "muse-wonder-choose",
      "text": "Muse Wonder is a preview aimed at long multi-file coding, multi-hour agent runs and sub-agent orchestration. Meta points high-volume, latency- or cost-sensitive work at Muse Spark instead.",
      "applies": [
        "muse-wonder-1.0"
      ],
      "class": "vendor",
      "source": "meta-models",
      "locator": "Choose Muse Wonder or Muse Spark",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "muse-wonder-full-muse-code-only",
      "text": "Muse Wonder Full exists only inside Muse Code on the Power Usage and Maximum Usage plans, and Meta publishes no model id for it. Max effort on muse-wonder-1.0 does not select it.",
      "applies": [
        "muse-wonder-full"
      ],
      "class": "vendor",
      "source": "meta-models",
      "locator": "Muse Wonder availability",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "muse-wonder-none-400",
      "text": "Never send reasoning effort none to Muse Wonder; Meta's API answers HTTP 400.",
      "applies": [
        "muse-wonder-1.0"
      ],
      "class": "vendor",
      "source": "meta-reasoning",
      "locator": "How it works, effort table, none row",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "muse-wonder-max-effort",
      "text": "Keep max effort on Muse Wonder for problems where a right answer beats speed, such as a concurrency bug or a large migration plan; it reasons longer and bills more tokens.",
      "applies": [
        "muse-wonder-1.0"
      ],
      "class": "vendor",
      "source": "meta-reasoning",
      "locator": "Max reasoning on Muse Wonder",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "muse-wonder-reasoning-budget",
      "text": "Reasoning tokens count against max_tokens or max_output_tokens and bill as output, so leave room for reasoning when sizing an output limit.",
