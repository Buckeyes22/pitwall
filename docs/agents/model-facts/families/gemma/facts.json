  "guidance": [
    {
      "id": "gemma-thinking-is-on-off",
      "text": "Gemma 4 thinking is a switch, not levels. Put the think token in the system turn to turn it on; leave it out to turn it off. There is no effort setting.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-gemma-4-card",
      "locator": "Best Practices, Thinking Mode Configuration",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gemma-strip-thoughts",
      "text": "Remove the model's thought text from earlier turns before sending history back. Keep it only within one turn that makes tool calls.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-gemma-4-formatting",
      "locator": "Managing Thought Context Between Turns",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gemma-empty-thought-when-off",
      "text": "The 12B, 26B A4B, and 31B models may still open an empty thought block, or a real one, with thinking off; the chat template adds an empty block to steady them.",
      "applies": [
        "gemma-4-31b-it",
        "gemma-4-26b-a4b",
        "gemma-4-12b"
      ],
      "class": "vendor",
      "source": "google-gemma-thinking",
      "locator": "A single text inference with Thinking, note",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gemma-one-sampling-setting",
      "text": "Use one sampling setting for every task: temperature 1.0, top_p 0.95, top_k 64.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-gemma-4-card",
      "locator": "Best Practices, Sampling Parameters",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gemma-image-before-text",
      "text": "With images and text, put the image before the text; put audio after the text.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-gemma-4-card",
      "locator": "Best Practices, Modality order",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "gemma-low-thinking-by-instruction",
      "text": "To spend fewer thinking tokens, ask for brief thinking in the system instruction; the vendor measured about 20 percent fewer, and calls it a proof of concept.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-gemma-4-formatting",
      "locator": "Tip: Adaptive Thought Efficiency using System Instructions",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    }
  ]
