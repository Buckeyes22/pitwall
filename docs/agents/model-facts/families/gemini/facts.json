  "guidance": [
    {
      "id": "gemini-drop-sampling-params",
      "text": "Leave temperature, top_p, and top_k out of Gemini requests; Google deprecated all three in July 2026.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-changelog",
      "locator": "July 21, 2026, Deprecated parameters",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-agy-plan-availability",
      "text": "agy serves Gemini 4 Argon on paid Google AI Pro, Ultra, and Enterprise plans, not on Free, Plus, or a Pro trial; 3.7 Flash, 3.6 Flash, and 3.1 Pro are Enterprise only. Run agy models to see what an account can pin.",
      "applies": [
        "*"
      ],
      "class": "harness",
      "source": "antigravity-models",
      "locator": "Reasoning model, plan table and footnotes",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-16"
    },
    {
      "id": "gemini-thinking-dynamic",
      "text": "Gemini models think dynamically by default and scale effort to the request; set thinking_level only to cap cost or force depth.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "google-thinking",
      "locator": "Controlling thinking",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-4-argon-effort",
      "text": "Medium is Gemini 4 Argon's default and Google's pick for most code and agent work. Keep high for the hardest reasoning, and test all three levels before settling on the lowest that passes.",
      "applies": [
        "gemini-4-argon"
      ],
      "class": "vendor",
      "source": "google-latest-model",
      "locator": "Understanding thinking levels",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-4-argon-output-budget",
      "text": "On Gemini 4 Argon, thinking and the answer share max_output_tokens. Keep that limit at 32,768 or more, and lower thinking_level rather than the limit when tokens must be saved.",
      "applies": [
        "gemini-4-argon"
      ],
      "class": "vendor",
      "source": "google-latest-model",
      "locator": "Setting output token limits",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-4-argon-sync-cap",
      "text": "A synchronous Gemini 4 Argon request is capped at 65,536 output tokens, and a higher max_output_tokens returns a 400. Longer answers need background execution (long decode).",
      "applies": [
        "gemini-4-argon"
      ],
      "class": "vendor",
      "source": "google-long-decode",
      "locator": "Output limits, table",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-4-argon-no-explicit-cache",
      "text": "Gemini 4 Argon does not support explicit context caching. Remove cachedContents use; implicit caching covers prompts of 4,096 tokens or more.",
      "applies": [
        "gemini-4-argon"
      ],
      "class": "vendor",
      "source": "google-latest-model",
      "locator": "Migration checklist, explicit context caching",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-4-argon-timeouts",
      "text": "Hard Gemini 4 Argon prompts can take several minutes. Give the client at least a 15-minute timeout, or run the request in the background.",
      "applies": [
        "gemini-4-argon"
      ],
      "class": "vendor",
      "source": "google-latest-model",
      "locator": "Migration checklist, client timeouts",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-minimal-not-on-3-7",
      "text": "Do not ask Gemini 3.7 Flash for minimal thinking; the API rejects it. Use low, medium, or high.",
      "applies": [
        "gemini-3.7-flash"
      ],
      "class": "vendor",
      "source": "google-gemini-3-7-flash",
      "locator": "Capabilities, Thinking",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-3-8-token-use",
      "text": "Gemini 3.8 Flash spends more tokens on long agentic tasks by design; lower thinking_level to low for everyday work to cut cost.",
      "applies": [
        "gemini-3.8-flash"
      ],
      "class": "vendor",
      "source": "google-whats-new-3-8",
      "locator": "Introductory pricing, note on token use",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-10-13"
    },
    {
      "id": "gemini-minimal-not-on-3-8",
      "text": "Do not ask Gemini 3.8 Flash for minimal thinking; the API returns an error. Use low, medium, or high.",
      "applies": [
        "gemini-3.8-flash"
