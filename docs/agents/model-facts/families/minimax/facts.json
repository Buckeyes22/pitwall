  "guidance": [
    {
      "id": "minimax-m3-thinking-off",
      "text": "M3 starts with thinking off. Send thinking type adaptive to turn it on; type disabled keeps it off.",
      "applies": [
        "minimax-m3"
      ],
      "class": "vendor",
      "source": "minimax-anthropic-api",
      "locator": "Thinking Control table, MiniMax-M3 row",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "minimax-m2-thinking-always",
      "text": "M2.x always thinks. A request that disables thinking is accepted and ignored.",
