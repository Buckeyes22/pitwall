  "guidance": [
    {
      "id": "qwen38-effort-three-levels",
      "text": "Qwen3.8 open models take reasoning_effort xhigh (default), medium, or low. Any other value, including high, makes the chat template raise an error.",
      "applies": [
        "qwen3.8-27b",
        "qwen3.8-flash-next"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-27b",
      "locator": "chat_template.jinja lines 46-50; README, API Usage",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen38-low-effort-can-cost-more",
      "text": "In multi-turn agent work, low effort answers faster per turn but can cause failures and retries, so total time and tokens may rise. Keep the default for agent tasks.",
      "applies": [
        "qwen3.8-27b",
        "qwen3.8-flash-next"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-27b",
      "locator": "README, API Usage, tip after reasoning_effort levels",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen-sampling-thinking-versus-instruct",
      "text": "Sample with temperature 1.0 and top_p 0.95 while thinking; for non-thinking calls use temperature 0.7, top_p 0.8, and presence penalty 1.5. top_k is 20 in both.",
      "applies": [
        "qwen3.8-27b",
        "qwen3.8-flash-next"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-27b",
      "locator": "README, Best Practices, Sampling Parameters",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen38-give-output-room",
      "text": "For agent tasks, set the reasoning output limit to 262,144 tokens and the final answer limit to 131,072 tokens, inside the 1M window the hosted versions offer.",
      "applies": [
        "qwen3.8-27b",
        "qwen3.8-flash-next",
        "qwen3.8-flash"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-27b",
      "locator": "README, Best Practices, Adequate Output Length",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen-thinking-on-by-default",
      "text": "Qwen3.6 and 3.8 models think unless a request turns thinking off with enable_thinking false. Turn it off for simple chat or extraction to save time and tokens.",
      "applies": [
        "qwen3.8-flash",
        "qwen3.8-27b",
        "qwen3.6-27b",
        "qwen3.6-35b-a3b"
      ],
      "class": "vendor",
      "source": "alibaba-deep-thinking",
      "locator": "Supported Models, Qwen3.8 tab; enable_thinking usage note",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen-preserve-thinking-needs-reasoning-back",
      "text": "On qwen3.8-flash, preserve_thinking is on by default; the client must send earlier reasoning_content back in assistant messages for it to take effect.",
      "applies": [
        "qwen3.8-flash"
      ],
      "class": "vendor",
      "source": "alibaba-deep-thinking",
      "locator": "Pass Thinking Process",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen3-coder-next-no-thinking",
      "text": "Qwen3-Coder-Next never emits think blocks and needs no enable_thinking setting. The vendor suggests temperature 1.0, top_p 0.95, top_k 40.",
      "applies": [
        "qwen3-coder-next"
      ],
      "class": "artifact",
      "source": "hf-qwen3-coder-next",
      "locator": "README, Model Overview note; Best Practices",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen-context-native-versus-hosted",
      "text": "Open Qwen3.6 and 3.8 models run 262,144 tokens natively and stretch to about 1M with scaling. Hosted qwen3.8-flash offers 1M by default.",
      "applies": [
        "qwen3.8-27b",
        "qwen3.8-flash-next",
        "qwen3.6-27b",
        "qwen3.6-35b-a3b",
        "qwen3.8-flash"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-27b",
      "locator": "README, Model Overview, Context Length; note about the hosted version",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "qwen38-max-is-2.4t-base",
      "text": "qwen3.8-max is the hosted release of the open Qwen3.8-2.4T-A95B, adding vision input, non-thinking mode, a 1M window, and built-in tools. The open weights are thinking-only with a 262,144 window.",
      "applies": [
        "*"
      ],
      "class": "artifact",
      "source": "hf-qwen3.8-2.4t-a95b",
      "locator": "README.md, Qwen3.8-Max description",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-09-28"
    }
  ]
}
