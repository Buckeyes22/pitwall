  "guidance": [
    {
      "id": "glm-53-effort",
      "text": "GLM-5.3 and GLM-5.3-Flash take low, high, or max. Anything else, or nothing, becomes max, the default. Pass low or high explicitly to spend fewer tokens.",
      "applies": [
        "glm-5.3",
        "glm-5.3-flash"
      ],
      "class": "artifact",
      "source": "hf-glm-5.3",
      "locator": "README.md line 55",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-53-clear-thinking",
      "text": "The GLM-5.3 chat template keeps earlier reasoning unless told otherwise (clear_thinking defaults to false). For plain chat, pass clear_thinking true.",
      "applies": [
        "glm-5.3",
        "glm-5.3-flash"
      ],
      "class": "artifact",
      "source": "hf-glm-5.3",
      "locator": "README.md line 56",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-53-no-off-switch",
      "text": "GLM-5.3 always reasons and rejects thinking disabled. Where a caller used to switch thinking off, set reasoning_effort to low instead.",
      "applies": [
        "glm-5.3"
      ],
      "class": "vendor",
      "source": "zai-glm-5-3",
      "locator": "Feature Changes, migration note, line 36",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-52-effort-two-levels",
      "text": "GLM-5.2 has only high and max. A low request is treated as max, so it does not save tokens.",
      "applies": [
        "glm-5.2"
      ],
      "class": "artifact",
      "source": "hf-glm-5.2",
      "locator": "chat_template.jinja line 2",
      "surfaces": [
        "card"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-return-reasoning",
      "text": "In a tool loop, send each assistant turn back with its reasoning_content unedited and in order. Dropping it lowers quality and cache hits.",
      "applies": [
        "glm-5.3",
        "glm-5.3-flash",
        "glm-5.2",
        "glm-5.1"
      ],
      "class": "vendor",
      "source": "zai-thinking-mode",
      "locator": "Interleaved thinking, Tip; Preserved thinking, Check",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-flash-settings",
      "text": "For GLM-5.3-Flash the vendor suggests temperature 1, top_p 0.95, effort max, clear_thinking false, and tool_stream on for streamed requests.",
      "applies": [
        "glm-5.3-flash"
      ],
      "class": "vendor",
      "source": "zai-glm-5-3-flash",
      "locator": "Model Overview, Recommended Settings, line 57",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "glm-flash-vision",
      "text": "GLM-5.3-Flash accepts images, video, and files as well as text; GLM-5.3, GLM-5.2, and GLM-5.1 take text only.",
      "applies": [
        "glm-5.3-flash",
        "glm-5.3",
        "glm-5.2"
      ],
      "class": "vendor",
      "source": "zai-glm-5-3-flash",
      "locator": "Capability cards, Input Modality",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    }
  ]
