  "guidance": [
    {
      "id": "deepseek-thinking-sampling",
      "text": "In thinking mode, temperature and the two penalties are accepted but ignored. top_p below 0.95 is raised to 0.95; in non-thinking mode top_p is fixed at 1.0.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "deepseek-thinking",
      "locator": "Input and Output Parameters",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-reasoning-content",
      "text": "When a request carries tools, send earlier turns' reasoning_content back with them; without tools the API ignores it and drops it from the context.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "deepseek-thinking",
      "locator": "Input and Output Parameters, reasoning_content",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-retired-flash-names",
      "text": "The API names deepseek-v4-flash and deepseek-v4-flash-vision-exp are retired models: requests are served by V4.1 Flash and billed at its price. Use deepseek-flash.",
      "applies": [
        "deepseek-v4-flash",
        "deepseek-v4-flash-vision-exp"
      ],
      "class": "vendor",
      "source": "deepseek-pricing",
      "locator": "Model Details, footnote 1",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-agentic-top-p",
      "text": "For agentic work the model files recommend temperature 1.0 with top_p 0.95, and top_p 1.0 otherwise. Give high and max effort up to 384K output tokens.",
      "applies": [
        "*"
      ],
      "class": "artifact",
      "source": "hf-deepseek-v4-pro-0813",
      "locator": "README.md, How to Run Locally",
      "surfaces": [
        "card",
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-pro-no-vision",
      "text": "V4 Pro takes no image input on the API; use V4.1 Flash, or the open Vision Exp weights, when images are part of the task.",
      "applies": [
        "deepseek-v4-pro"
      ],
      "class": "vendor",
      "source": "deepseek-pricing",
      "locator": "Model Details, Vision row",
      "surfaces": [
        "card"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-fim-non-thinking",
      "text": "FIM and chat prefix completion are beta features; FIM works only with thinking turned off.",
      "applies": [
        "*"
      ],
      "class": "vendor",
      "source": "deepseek-pricing",
      "locator": "Model Details, Features table",
      "surfaces": [
        "reference"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-flash-api-name",
      "text": "Call DeepSeek V4.1 Flash on the API as deepseek-flash; it takes image input, unlike V4 Pro, and thinking is on by default at high effort.",
      "applies": [
        "deepseek-v4.1-flash"
      ],
      "class": "vendor",
      "source": "deepseek-pricing",
      "locator": "Model Details, MODEL and Vision rows",
      "surfaces": [
        "reference",
        "ledger"
      ],
      "reviewedAt": "2026-09-28"
    },
    {
      "id": "deepseek-flash-effort-api",
      "text": "The API accepts low, high, and max effort; the open weights also take a numeric effort from 1 to 100, which hosted routes do not expose.",
      "applies": [
        "deepseek-v4.1-flash"
      ],
