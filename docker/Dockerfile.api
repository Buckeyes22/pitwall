FROM python:3.14.7-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS builder

ARG UV_VERSION=0.12.23
WORKDIR /build

COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY db/migrations/ db/migrations/
COPY docs/models/ docs/models/
COPY config/gateway-catalog.json config/gateway-catalog.lock.json config/gateway-routes.json config/
COPY seed/gateway-providers.yaml seed/gateway-capabilities.yaml seed/
COPY plugins/ plugins/
COPY src/ src/

RUN python -m pip install --no-cache-dir "uv==$UV_VERSION" && uv export --frozen --no-dev --no-emit-project --format requirements-txt --output-file /tmp/requirements.txt && python -m pip install --no-cache-dir --require-hashes --prefix=/install -r /tmp/requirements.txt && uv build --wheel --out-dir /tmp/dist && python -m pip install --no-cache-dir --no-deps --prefix=/install /tmp/dist/*.whl

FROM python:3.14.7-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS runtime

LABEL org.opencontainers.image.title="Pitwall API" org.opencontainers.image.description="RunPod broker control-plane API" org.opencontainers.image.licenses="Apache-2.0"

# Apply Debian security updates published after the pinned base image was built,
# so the scheduled Trivy scan never ships a fixed OS-package CVE.
RUN apt-get update && apt-get upgrade --yes --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Runtime images are immutable services, not package installation environments.
RUN python -m pip uninstall --yes pip && rm -rf /usr/local/lib/python3.14/ensurepip

RUN groupadd --system --gid 10001 pitwall && useradd --system --uid 10001 --gid pitwall --home-dir /app --create-home pitwall
WORKDIR /app
COPY --from=builder /install /usr/local

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PITWALL_API_HOST=0.0.0.0 PITWALL_API_PORT=8080

USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/readyz', timeout=3)"]
CMD ["python", "-m", "pitwall.api"]
